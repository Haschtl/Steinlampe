# Step 2 of the NimBLE-Arduino -> native-API + BLE Mesh migration (see the
# feat/ble-mesh plan): comms.cpp/midi_ble.cpp/presence_ble.cpp now talk to
# the native ESP-IDF NimBLE host directly - NimBLE on, Bluedroid stays off
# (nothing in this firmware uses it, per the ENABLE_BLE/ENABLE_BT_SERIAL
# #error in lamp_config.h). CONFIG_BLE_MESH* flags still deliberately held
# back for Step 3, same reasoning as spikes/ble-mesh/sdkconfig.defaults.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set

# Default is 3, matching BLE_MAX_CONCURRENT_CLIENTS in comms.cpp - but a
# *bond* (unlike a live connection) persists for a previously-trusted device
# that isn't currently connected, and the app-level trust list in comms.cpp
# (TRUST_MAX) allows remembering up to 12 devices over time. Bumped so a
# device bonded earlier doesn't get silently evicted from the crypto bond
# store (forcing a re-pair) just because newer devices bonded since.
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_MAX_CCCDS=8

# Arduino core itself requires this (CMakeLists.txt hard-checks it).
CONFIG_FREERTOS_HZ=1000

# Without this, no app_main() gets generated to call into Arduino's
# setup()/loop() - the final link fails with "undefined reference to
# app_main".
CONFIG_AUTOSTART_ARDUINO=y

# Both real boards this targets (upesy_wroom and on_air's ESP32-S3 Super
# Mini) have 4MB flash - without this it silently falls back to a
# 2MB-sized default partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Core dump (into the existing coredump partition, already in min_spiffs.csv)
# gives a full post-mortem via espcoredump.py for any future crash - cheap to
# leave on, costs nothing but a bit of flash that's already reserved.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Default (8192) measured on real hardware (desk_lamp, via a saved core
# dump's own per-task "STACK USED/FREE" table) hitting a genuine, repeatable
# stack overflow in loopTask at ~9040 bytes used while processing a "status"
# command with BLE active - a real FreeRTOS stack-overflow detection, a
# different mechanism/bug class from the three TLSF heap-corruption bugs
# fixed in commit 239bdb5 (those just happened to crash first, every time,
# masking this one until they were fixed). Root call chain not pinned down
# exactly (the saved backtrace is corrupted past the panic handler, as
# expected once the overflow has already happened) - bumped generously
# rather than trimming to the exact minimum, cheap in RAM terms relative to
# this chip's ~320KB.
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384
