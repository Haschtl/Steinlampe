<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Quarzlampe</string>
	<key>CFBundleDisplayName</key>
	<string>Quarzlampe</string>
	<key>CFBundleIdentifier</key>
	<string>dev.quarzlampe.tray</string>
	<key>CFBundleExecutable</key>
	<string>quarzlampe-tray</string>
	<key>CFBundleIconFile</key>
	<string>quarzlampe.icns</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<!-- Required by macOS's privacy-gate for any CoreBluetooth access (the
	     daemon owns the lamp's BLE connection) - without this key, the
	     process hard-crashes the instant it touches Bluetooth, with
	     "attempted to access privacy-sensitive data without a usage
	     description" in the system log. Found live: it crashed silently
	     every time when launched normally through Finder/LaunchServices,
	     while launching the same binary directly from a Terminal somehow
	     didn't trip the same check - but the missing key was the real bug
	     either way, not the launch method. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Quarzlampe connects to your lamp over Bluetooth to control it and run your automation rules.</string>
	<!-- No Dock icon/menu bar app switcher entry for the daemon itself -
	     it's a tray-only process; the console window (spawned on demand)
	     still shows normally since LSUIElement only affects the bundle's
	     own primary executable's app-switcher presence. -->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
